# --- Server ---
HTTP_ADDR=:8080
TCP_ADDR=:5023

# --- Postgres ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/trucktracker?sslmode=disable

# --- Firebase (path to service account JSON) ---
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json

# --- App ---
APP_JWT_SECRET=change-me-to-a-32-byte-random-string
APP_JWT_TTL=24h

# --- Logging ---
LOG_LEVEL=info
